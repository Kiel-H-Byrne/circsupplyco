# Publishable API key for the Medusa backend.
# You will need to create this in the Medusa Admin once deployed, or run a script to generate it.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_d797fc78b86a12b274876930e2f6cabdf1f3991f2b3a8ecafbfa97729ea59ddc

# URL of the Medusa backend API server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://medusa-backend-2qna76uv3a-uc.a.run.app

# Default region code to use for the storefront
NEXT_PUBLIC_DEFAULT_REGION=us

# Base URL of the storefront (production URL)
